{
  "name": "pi-annotate-local",
  "version": "0.1.0",
  "private": true,
  "description": "Visual annotation extension for pi - review messages and markdown documents in a local browser UI",
  "type": "module",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "annotation",
    "review"
  ],
  "files": [
    "index.ts",
    "server.ts",
    "settings.ts",
    "markdown.ts",
    "review.ts",
    "review-extension.ts",
    "demo.ts",
    "form/"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2"
  }
}
