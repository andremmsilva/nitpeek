{
  "name": "nitpeek",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Review what your coding agent did — highlight, note, and hand the notes back (Pi, Claude Code)",
  "type": "module",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "pi-package",
    "claude-code",
    "review",
    "annotation"
  ],
  "files": [
    "core/",
    "hosts/",
    "ui/index.html",
    "dist/"
  ],
  "pi": {
    "extensions": [
      "./hosts/pi/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.9",
    "markdown-it": "^15.0.2",
    "node-tikzjax": "^1.0.5",
    "preact": "^10.29.8"
  },
  "scripts": {
    "build": "bun build ui/app.tsx --outfile dist/app.js --minify --target browser && cp ui/styles.css dist/app.css && bun scripts/katex-assets.ts",
    "demo": "bun demo/serve.ts",
    "test": "./tests/run.sh"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
